{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "module": "esnext",
    "rootDir": "./",
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true
  },
  "extends": "expo/tsconfig.base"
}